# SQLite для разработки. Для PostgreSQL: postgresql://user:pass@host:5432/edu
DATABASE_URL="file:./dev.db"
# Секрет Auth.js: сгенерируйте `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET="замените-на-длинную-случайную-строку"
# Часовой пояс центра (определяет «сегодня» для уроков)
APP_TIMEZONE="Asia/Tashkent"
# Пароль администратора для первого сида (по умолчанию admin123)
SEED_ADMIN_PASSWORD=""
# Хранилище фото: local (папка ./storage) или s3 (облако: S3, Cloudflare R2, Supabase, Backblaze, MinIO)
STORAGE_DRIVER="local"
# STORAGE_DIR="storage"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="edu-center"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
