// Схема БД учебного центра.
// Провайдер переключается скриптом scripts/db-provider.mjs по DATABASE_URL
// (file:… → sqlite, postgres://… → postgresql). См. README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  DONE
  PARTIAL
  NOT_DONE
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  teacher      Teacher?
  student      Student?

  @@index([role])
}

model Teacher {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]
  groups   Group[]
}

model Student {
  id          String               @id @default(cuid())
  userId      String               @unique
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentPhone String               @default("")
  birthDate   DateTime?
  groups      GroupStudent[]
  attendance  Attendance[]
  grades      Grade[]
  submissions HomeworkSubmission[]
}

model Subject {
  id       String    @id @default(cuid())
  name     String    @unique
  teachers Teacher[]
  groups   Group[]
}

model Group {
  id        String         @id @default(cuid())
  name      String         @unique
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  level     String         @default("")
  createdAt DateTime       @default(now())
  students  GroupStudent[]
  slots     ScheduleSlot[]
  lessons   Lesson[]
  grades    Grade[]
  homework  Homework[]

  @@index([teacherId])
  @@index([subjectId])
}

model GroupStudent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

model ScheduleSlot {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // 1 = понедельник … 7 = воскресенье
  dayOfWeek Int
  startTime String
  endTime   String
  room      String @default("")

  @@index([groupId])
}

model Lesson {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Дата урока (полночь UTC календарного дня)
  date       DateTime
  startTime  String
  endTime    String
  topic      String       @default("")
  attendance Attendance[]
  grades     Grade[]

  @@unique([groupId, date, startTime])
  @@index([date])
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  date      DateTime
  value     Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([studentId, date])
  @@index([groupId])
  @@index([lessonId])
}

model Homework {
  id          String               @id @default(cuid())
  groupId     String
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String               @default("")
  dueDate     DateTime
  createdAt   DateTime             @default(now())
  submissions HomeworkSubmission[]

  @@index([groupId, dueDate])
}

model HomeworkSubmission {
  id         String         @id @default(cuid())
  homeworkId String
  homework   Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     HomeworkStatus

  @@unique([homeworkId, studentId])
  @@index([studentId])
}
